# VIVE backend configuration. Copy to .env and edit.
# .env is git-ignored; never commit real secrets.

VIVE_ENV=development
VIVE_LOG_LEVEL=INFO

# Comma-separated bearer tokens accepted by the API.
# Empty in development = auth is not enforced (see SECURITY_SPEC 2).
VIVE_API_TOKENS=

# HMAC key used to sign outbound webhooks.
VIVE_WEBHOOK_SIGNING_KEY=

# Session and streaming behaviour
VIVE_SESSION_TTL_SECONDS=3600
VIVE_WS_HEARTBEAT_SECONDS=20
VIVE_WS_IDLE_TIMEOUT_SECONDS=60

# Adapter mode: mock | real. Only "mock" is implemented in this phase.
VIVE_ADAPTER_MODE=mock

# Privacy. Raw audio is never persisted unless this is enabled AND a storage
# backend exists; the current in-memory store has no disk path at all.
VIVE_RETAIN_RAW_AUDIO=false
VIVE_SESSION_RETENTION_SECONDS=3600

# Rate limiting (per process, not distributed).
VIVE_RATE_LIMIT_REQUESTS=120
VIVE_RATE_LIMIT_WINDOW_SECONDS=60
VIVE_RATE_LIMIT_SESSION_CREATES=20

# Refuse plaintext forwarded requests. TLS is terminated by the deployment;
# this only enforces that it happened.
VIVE_REQUIRE_TLS=false
