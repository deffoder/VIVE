# VIVE backend configuration. Copy to .env and edit.
# .env is git-ignored; never commit real secrets.

VIVE_ENV=development
VIVE_LOG_LEVEL=INFO

# Comma-separated bearer tokens accepted by the API.
# Empty in development = auth is not enforced (see SECURITY_SPEC 2).
VIVE_API_TOKENS=

# HMAC key used to sign outbound webhooks.
VIVE_WEBHOOK_SIGNING_KEY=

# Session and streaming behaviour
VIVE_SESSION_TTL_SECONDS=3600
VIVE_WS_HEARTBEAT_SECONDS=20
VIVE_WS_IDLE_TIMEOUT_SECONDS=60

# Adapter mode: mock | real.
#
#   mock - deterministic scripted adapters. No weights needed, reproducible,
#          and what the demo scenarios are specified against. The DEFAULT.
#   real - checkpoint-backed adapters. Requires every VIVE_*_MODEL_DIR below.
#
# A real adapter that cannot load reports LOAD_ERROR and STAYS in real mode.
# The bundle never silently downgrades to mock, because a demo that looks
# identical whether or not the model loaded is indistinguishable from a
# fabricated result (docs/ML_SPEC.md 4).
VIVE_ADAPTER_MODE=mock

# Model directories. Required only when VIVE_ADAPTER_MODE=real. Weights live
# OUTSIDE git (docs/ML_SPEC.md 8.6), so these are deployment configuration.
# Empty means "not configured", which yields LOAD_ERROR in real mode rather
# than a guess at a default location.
VIVE_ASR_MODEL_DIR=
VIVE_VAD_MODEL_DIR=
VIVE_ANTISPOOF_MODEL_DIR=
VIVE_SPEAKER_MODEL_DIR=
VIVE_INTENT_MODEL_DIR=
VIVE_BEHAVIOR_MODEL_DIR=

# Decoding language when a session declares "auto". The CTC decoder applies a
# per-language vocabulary mask, so language is a required INPUT, not an
# output, and there is no language-ID model.
VIVE_ASR_DEFAULT_LANGUAGE=hi

# Request the CUDA execution provider when onnxruntime exposes one. Default
# false: on CPU-only installs onnxruntime has no CUDA provider, and the
# adapter reports the provider that actually served the graph rather than the
# one requested.
VIVE_ASR_PREFER_GPU=false

# Privacy. Raw audio is never persisted unless this is enabled AND a storage
# backend exists; the current in-memory store has no disk path at all.
VIVE_RETAIN_RAW_AUDIO=false
VIVE_SESSION_RETENTION_SECONDS=3600

# Rate limiting (per process, not distributed).
VIVE_RATE_LIMIT_REQUESTS=120
VIVE_RATE_LIMIT_WINDOW_SECONDS=60
VIVE_RATE_LIMIT_SESSION_CREATES=20

# Refuse plaintext forwarded requests. TLS is terminated by the deployment;
# this only enforces that it happened.
VIVE_REQUIRE_TLS=false
