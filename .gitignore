# --- Secrets / local config ---
.env
.env.*
!.env.example
*.pem
*.key
local.properties
secrets.properties

# --- Python (backend/) ---
__pycache__/
*.py[cod]
*.so
.Python
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node (frontend/) ---
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Android / Gradle ---
.gradle/
android/build/
android/app/build/
android/.cxx/
*.apk
*.aab
*.aar
*.jks
*.keystore
captures/

# --- Model checkpoints (large binaries) ---
# Structure under models/ is tracked; weights are not.
models/artifacts/**
!models/artifacts/.gitkeep
*.pth
*.pt
*.onnx
*.bin
*.safetensors
*.ckpt

# --- Datasets ---
# Structure, manifests and README are tracked; audio corpora are not.
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# --- Audio ---
*.wav
*.mp3
*.flac
*.m4a
*.ogg
!tests/fixtures/**

# --- Notebooks ---
models/notebooks/**/.ipynb_checkpoints/

# --- IDE ---
.idea/
*.iml
.vscode/
!.vscode/extensions.json

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
